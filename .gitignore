# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments (each collaborator creates their own)
.venv/
venv/
env/
ENV/

# ---- Runtime save data (per-player, never share) ----
# arcade_lobby/settings.py SAVE_FILE, its .tmp/.migrated siblings, and per-profile saves
arcade_lobby/save_data.json
arcade_lobby/save_data.json.*
arcade_lobby/saves/
.arcade.lock

# puzzle_maze keeps its own per-player saves next to the code (save.json, save_v2.json ... save_v4.json,
# their .tmp files and .v20.bak backups). Test fixtures live in puzzle_maze/tests/fixtures and stay tracked.
puzzle_maze/save*.json
puzzle_maze/save*.json.*

# ---- Test / coverage / debug output ----
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.hypothesis/
*.log
*.prof
nohup.out

# ---- Type checker / linter caches ----
.mypy_cache/
.ruff_cache/
.pytype/

# ---- Local secrets and config (personal, never commit) ----
.env
.env.*
!.env.example
*.local
.claude/settings.local.json
.claude/worktrees/

# ---- Editors / IDEs ----
# Personal editor state is ignored; shared project settings may still be committed.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.vim/
*.sublime-workspace

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini
*:Zone.Identifier

# ---- Build / packaging ----
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# ---- Generated screenshots / review output (regenerate locally) ----
review_screenshots/

# ---- Scratch files ----
tmp/
*.tmp
*.bak
*.orig
*.rej
